# LLM local (llama.cpp servido pelo ODS) para o resumo direcionado de conduta.
QWEN_ENDPOINT=http://127.0.0.1:11434/v1
QWEN_MODEL=local-model
QWEN_TIMEOUT_SEGUNDOS=180

DUCKDB_PATH=./data/pcdt.duckdb

# Portal do governo: intervalo entre downloads de PDF.
COLETA_DELAY_SEGUNDOS=1

# Horario fixo: os syncs locais sao escalonados de madrugada porque a GPU
# serializa as chamadas ao Qwen. Este roda logo depois do CFM.
SYNC_HORA_LOCAL=02:40

LOG_LEVEL=INFO
